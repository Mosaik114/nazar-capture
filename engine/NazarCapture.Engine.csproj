<Project Sdk="Microsoft.NET.Sdk">

  <!-- Capture engine: screenshot overlay/editor and screen recording (WPF, .NET Framework 4.8). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>NazarCapture.Engine</AssemblyName>
    <RootNamespace>NazarCapture.Engine</RootNamespace>
    <StartupObject>NazarCapture.Engine.Core.Program</StartupObject>
    <ApplicationIcon>..\assets\capture.ico</ApplicationIcon>
    <ApplicationManifest>..\assets\app.manifest</ApplicationManifest>
    <Version>1.1.8</Version>
    <Product>Nazar Capture</Product>
    <Company>Nazar Capture</Company>
    <Description>Screenshot and screen recording engine of Nazar Capture</Description>
    <!-- FileDescription, which Task Manager shows. -->
    <AssemblyTitle>Nazar Capture Engine</AssemblyTitle>
    <!-- Ship the exe alone, as before (no generated .exe.config pinning the runtime SKU). -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows.Media.Ocr and Windows.Graphics.Imaging (WinRT) for text recognition. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nunito (SIL Open Font License 1.1, see NazarUi/Fonts/OFL.txt): the rounded face of the kit, embedded
         together with its license. The token dictionaries NazarUi/*.xaml are compiled as pages (UseWPF default). -->
    <Resource Include="NazarUi\Fonts\Nunito-wght.ttf" />
    <Resource Include="NazarUi\Fonts\OFL.txt" />
    <!-- The logo for window heads (generated by design/logo/nazar_logo.py). -->
    <Resource Include="NazarUi\Logo\nazar_mark.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Framework assemblies of .NET 4.8 (nothing downloaded): JSON of the GitHub API and unpacking the update ZIP. -->
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NazarCapture.Engine.Tests" />
  </ItemGroup>

</Project>
