<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables; they also run through `dotnet test` (VSTest). -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>NazarCapture.Engine.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- xUnit v3 without Microsoft.Testing.Platform, so `dotnet test` works without a global.json opt-in. -->
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine\NazarCapture.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- JavaScriptSerializer reads contract/contract.json, the IPC and settings contract shared with the Rust host. -->
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <None Include="..\..\contract\contract.json" Link="contract.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The design tokens and Hams' generated values (TokenTests). -->
    <None Include="..\..\design\design-tokens.json" Link="design-tokens.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\design\generated\hams-theme-values.json" Link="hams-theme-values.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference images for the pixel tests (trait Category=Pixel; skipped when the fonts of the references are missing). -->
    <None Include="References\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Lets NAZAR_UPDATE_REFERENCES=1 write new reference images back into the source tree. -->
    <AssemblyMetadata Include="ReferenceSourceDirectory" Value="$(MSBuildProjectDirectory)\References" />
    <!-- The repository, for the structure tests that read the engine's source (StructureTests). -->
    <AssemblyMetadata Include="RepositoryDirectory" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))" />
  </ItemGroup>

  <ItemGroup Condition="'$(NazarReadme)' == 'true'">
    <!-- The renders for the README pictures, only for tools/readme/render.ps1. -->
    <Compile Include="..\..\tools\readme\ReadmeRenders.cs" Link="ReadmeRenders.cs" />
  </ItemGroup>

</Project>
